# Copia este archivo a .env y completa los valores. .env NO se sube a git.
# En Render estas variables se definen en el panel (Environment), no en un archivo.

# ── Entorno ─────────────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Base de datos ───────────────────────────────────────────────────────────────────────────────
# Opción 1 (recomendada y la que entrega Render): una sola URL.
# El valor de abajo es el de docker-compose.yml para desarrollo local; en producción usa la URL de tu base.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/booking_db
# Opción 2: variables sueltas. Solo se usan si DATABASE_URL está vacía.
# DB_HOST=
# DB_PORT=5432
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
# SSL: se activa solo cuando NODE_ENV=production. Pon false para apagarlo (base sin SSL) o true para forzarlo.
# DATABASE_SSL=

# ── Seguridad ───────────────────────────────────────────────────────────────────────────────────
# Mínimo 32 caracteres, sin valor por defecto. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Superadmin inicial que crea `npm run seed` (en producción: `npm run seed:prod`). Contraseña de 8 a 72 caracteres.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# ── Red ─────────────────────────────────────────────────────────────────────────────────────────
# Orígenes del frontend permitidos por CORS, separados por comas y sin barra final.
# Vacío = ningún origen salvo localhost. Fuera de producción siempre se permite http://localhost:5173.
CORS_ORIGIN=
# Detrás de un proxy (Render) pon 1, para que el límite de intentos de login use la IP real del cliente.
# Valores: false (por defecto), true, un número de saltos o una lista de IP/subredes.
TRUST_PROXY=
