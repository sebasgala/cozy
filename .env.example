DATABASE_URL="postgresql://postgres:postgres@localhost:5432/booking_db?schema=public"
NODE_ENV=development
PORT=3000

# Seguridad (paso 8). JWT_SECRET: minimo 32 caracteres, sin valor por defecto.
# Generar uno: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Superadmin inicial que crea `npm run seed` (nunca credenciales fijas en el codigo). Contrasena de 8 a 72 caracteres.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
